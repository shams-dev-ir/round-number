[Unit]
Description=Rondix — Next.js frontend
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy

# A symlink. systemd resolves it at start, so restarting the unit is what
# actually promotes a newly uploaded release.
WorkingDirectory=/var/www/rondix/current

# Written by server-setup.sh. Holds PORT, which is chosen at setup time from
# whatever is actually free on this machine, plus HOSTNAME=127.0.0.1 so the app
# binds to loopback only and nginx stays the sole public entry point.
EnvironmentFile=/etc/rondix.env

ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/rondix

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rondix

[Install]
WantedBy=multi-user.target
