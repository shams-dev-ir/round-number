# Normalise line endings in the repo, and check out LF for anything that Linux
# executes. A CRLF in server-setup.sh makes bash fail with `$'\r': command not
# found` on the server, which is a confusing way to lose an afternoon.
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.service text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf

# Binary — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
